# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=lawfirm.example.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://lawfirm.example.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://lawfirm.example.com,http://localhost:3000,http://127.0.0.1:3000

# Superuser Credentials
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisPassword123!
DJANGO_SUPERUSER_NAME=Super Admin

# Database Configuration (PostgreSQL container)
POSTGRES_DB=lawfirm_db
POSTGRES_USER=lawfirm_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Port Configuration
WEB_PORT=8005
DB_PORT=5438

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=huzaifanasirfab@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=huzaifanasirfab@gmail.com

# OTP Settings
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Frontend URL
FRONTEND_URL=https://lawfirm.example.com

# Password reset expiry in seconds (1 hour)
PASSWORD_RESET_TIMEOUT=3600
